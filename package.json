{
  "name": "sift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted inbox triage: labels, archives, filters and unsubscribes, using inference only when cheaper tiers abstain.",
  "bin": {
    "sift": "src/cli/main.ts"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "sift": "node --disable-warning=ExperimentalWarning src/cli/main.ts",
    "typecheck": "tsc --noEmit && next typegen && tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint",
    "format": "oxlint --fix && oxfmt src tests web/src app proxy.ts instrumentation.ts next.config.js vitest.config.ts playwright.config.ts e2e .claude/skills/verify-sift/scripts",
    "format:check": "oxfmt --check src tests web/src app proxy.ts instrumentation.ts next.config.js vitest.config.ts playwright.config.ts e2e .claude/skills/verify-sift/scripts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "measure": "node --disable-warning=ExperimentalWarning e2e/measure.ts",
    "startup-images": "node --disable-warning=ExperimentalWarning e2e/startup-images.ts",
    "knip": "knip",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm knip && pnpm format:check",
    "check": "pnpm check:fast && pnpm test && pnpm e2e",
    "build:web": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "pnpm sift run",
    "dev": "pnpm sift dev",
    "db:generate": "drizzle-kit generate",
    "db:reset": "pnpm sift reset-db"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.1.0",
    "@workflow/vitest": "5.0.9",
    "client-only": "0.0.1",
    "cn": "^0.5.2",
    "drizzle-kit": "0.31.11",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "lucide-react": "^1.74.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2005",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "@earendil-works/pi-ai": "^1.5.2",
    "@electric-sql/pglite": "0.5.16",
    "@googleapis/gmail": "^22.1.0",
    "@sentry/browser": "11.13.0",
    "@sentry/node": "11.13.0",
    "@vercel/functions": "^3.11.3",
    "drizzle-orm": "0.45.4",
    "google-auth-library": "^11.3.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "redis": "^5.12.2",
    "workflow": "5.5.0",
    "zod": "^4.6.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm knip"
  },
  "lint-staged": {
    "{src,tests,e2e,app,web/src,.claude/skills/verify-sift/scripts}/**/*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "{proxy,instrumentation,vitest.config,playwright.config}.ts": [
      "oxlint --fix",
      "oxfmt"
    ],
    "next.config.js": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
